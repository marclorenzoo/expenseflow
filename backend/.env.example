# Connection string de PostgreSQL. Con Neon, añade pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://usuario:password@host/expenseflow?sslmode=require"

# Secret para firmar y verificar access y refresh tokens
JWT_SECRET="your_secret_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API key de Groq para el OCR de tickets con IA (https://console.groq.com)
GROQ_API_KEY=""

# Origen permitido por CORS y para los rooms de realtime
FRONTEND_URL="http://localhost:4200"

PORT=3000
